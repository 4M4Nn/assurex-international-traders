# Canonical production URL (no trailing slash). Set this once the custom domain is live.
NEXT_PUBLIC_SITE_URL=https://assurex-international-traders.vercel.app

# --- Enquiry delivery: configure at least one channel, or the forms will offer WhatsApp instead ---
# Email via Resend (https://resend.com). The sending domain must be verified in Resend.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL="Assurex Website <enquiries@your-verified-domain.com>"
# Optional webhook (CRM, Google Sheets automation, Slack, etc.) — receives JSON for each enquiry.
ENQUIRY_WEBHOOK_URL=

# --- Measurement (optional) ---
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Loads only after visitor consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console HTML-tag verification token (content value only).
GOOGLE_SITE_VERIFICATION=
